# ─────────────────────────────────────────────────────────
# Credit Risk Engine — Backend Environment Variables
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────
# Supabase Connection Pooler URL (Transaction mode, port 6543)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection URL (used for migrations only)
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# ── JWT Authentication ─────────────────────────────────────
# Generate a strong secret: `openssl rand -hex 64`
JWT_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_64_CHARS"

# Session cookie secret — MUST be different from JWT_SECRET
# Generate independently: `openssl rand -hex 64`
SESSION_SECRET="REPLACE_WITH_DIFFERENT_STRONG_RANDOM_SECRET_MIN_64_CHARS"

# Refresh token signing secret — MUST differ from JWT_SECRET and SESSION_SECRET
# Generate independently: `openssl rand -hex 64`
REFRESH_SECRET="REPLACE_WITH_THIRD_DISTINCT_RANDOM_SECRET_MIN_64_CHARS"

# Access token TTL (short-lived)
JWT_TTL_PROD="15m"
JWT_TTL_DEV="24h"

# Refresh token TTL (long-lived, rotated on use)
REFRESH_TTL="7d"

# ── Server ────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Frontend CORS Origin ──────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Python Scoring Service ────────────────────────────────
# URL of the FastAPI scoring microservice
SCORING_SERVICE_URL=http://localhost:8000

# ── Prisma Engine (for corporate networks) ────────────────
# Use npm mirror if github downloads are blocked
# PRISMA_ENGINES_MIRROR=https://registry.npmmirror.com/-/binary/prisma

# ── Microfinance Integrations ─────────────────────────────
# Set to true only when connecting to a real mobile money API
MOMO_LIVE_MODE=false
