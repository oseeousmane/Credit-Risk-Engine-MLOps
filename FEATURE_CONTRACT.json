        { "name": "DAYS_EMPLOYED", "description": "Days since business registration / employment start", "type": "INTEGER", "mandatory": true },
        { "name": "NAME_INCOME_TYPE", "description": "Type of income source (Corporate, Associate, etc.)", "type": "CATEGORICAL", "mandatory": true },
