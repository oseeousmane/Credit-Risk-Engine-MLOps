  "imputation_policy": {
    "max_allowed_imputation_rate": 0.40,
    "critical_non_nullable_fields": [
      "EXT_SOURCE_1", "EXT_SOURCE_2", "EXT_SOURCE_3",
      "DEBT_TO_INCOME", "CREDIT_TO_INCOME_RATIO",
      "DAYS_EMPLOYED", "AMT_CREDIT", "AMT_INCOME_TOTAL",
      "BUREAU_CREDIT_UTILIZATION"
    ],
    "quality_bands": {
      "HIGH":   { "max_imputed_features": 15,  "decision_allowed": true,  "human_review_required": false },
      "MEDIUM": { "max_imputed_features": 63,  "decision_allowed": true,  "human_review_required": false },
      "LOW":    { "max_imputed_features": 157, "decision_allowed": false, "human_review_required": true  }
    },
    "imputation_strategy": {
      "NUMERIC":     "median sur train set",
      "CATEGORICAL": "mode sur train set",
      "BINARY":      "0 (conservative)"
    }
  },
  "fairness_protected_variables": {
    "note": "Variables à surveiller pour les tests de disparate impact (COBAC / Basel III Pilier 2 gouvernance).",
    "variables": ["CODE_GENDER", "AGE_YEARS", "NAME_EDUCATION_TYPE", "REGION_POPULATION_RELATIVE"],
    "current_status": "Tests effectués sur Home Credit. Non validé sur données CEMAC réelles."
  },
  "fallback_engine_business_rules": {
    "description": "Règles appliquées quand le moteur ML est offline. Seuils définis par le Comité des Risques.",
